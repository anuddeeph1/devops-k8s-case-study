              "shortDescription": {
                "text": "GHSA-6v2p-p543-phr9 high vulnerability for golang.org/x/oauth2 package"
              },
              "fullDescription": {
                "text": "golang.org/x/oauth2 Improper Validation of Syntactic Correctness of Input vulnerability"
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability GHSA-6v2p-p543-phr9\nSeverity: high\nPackage: golang.org/x/oauth2\nVersion: v0.23.0\nFix Version: 0.27.0\nType: go-module\nLocation: /usr/bin/kubectl\nData Namespace: github:language:go\nLink: [GHSA-6v2p-p543-phr9](https://github.com/advisories/GHSA-6v2p-p543-phr9)",
                "markdown": "**Vulnerability GHSA-6v2p-p543-phr9**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | golang.org/x/oauth2  | v0.23.0  | 0.27.0  | go-module  | /usr/bin/kubectl  | github:language:go  | [GHSA-6v2p-p543-phr9](https://github.com/advisories/GHSA-6v2p-p543-phr9)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:golang/golang.org/x/oauth2@v0.23.0"
                ],
                "security-severity": "7.5"
              }
