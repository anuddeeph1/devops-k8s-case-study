    {
      "vulnerability": {
        "name": "CVE-2025-5025",
        "description": "libcurl supports *pinning* of the server certificate public key for HTTPS transfers. Due to an omission, this check is not performed when connecting with QUIC for HTTP/3, when the TLS backend is wolfSSL. Documentation says the option works with wolfSSL, failing to specify that it does not for QUIC and HTTP/3. Since pinning makes the transfer succeed if the pin is fine, users could unwittingly connect to an impostor server without noticing."
      },
      "products": [
        {
          "@id": "nginx:1.25-alpine",
          "subcomponents": [
            {
              "@id": "pkg:apk/alpine/curl@8.5.0-r0?arch=x86_64&distro=alpine-3.19.1&package-id=dea0bf49af47f88e",
              "name": "curl",
              "version": "8.5.0-r0",
              "purl": "pkg:apk/alpine/curl@8.5.0-r0?arch=x86_64&distro=alpine-3.19.1"
            }
          ]
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "Severity: MEDIUM - libcurl supports *pinning* of the server certificate public key for HTTPS transfers. Due to an omission, this check is not performed when connecting with QUIC for HTTP/3, when the TLS backend is wolfSSL. Documentation says the option works with wolfSSL, failing to specify that it does not for QUIC and HTTP/3. Since pinning makes the transfer succeed if the pin is fine, users could unwittingly connect to an impostor server without noticing.",
      "action_statement": "Component found in SBOM: curl"
    },
