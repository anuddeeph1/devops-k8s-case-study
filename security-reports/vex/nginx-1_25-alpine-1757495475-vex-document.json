    {
      "vulnerability": {
        "name": "CVE-2024-28182",
        "description": "nghttp2 is an implementation of the Hypertext Transfer Protocol version 2 in C. The nghttp2 library prior to version 1.61.0 keeps reading the unbounded number of HTTP/2 CONTINUATION frames even after a stream is reset to keep HPACK context in sync.  This causes excessive CPU usage to decode HPACK stream. nghttp2 v1.61.0 mitigates this vulnerability by limiting the number of CONTINUATION frames it accepts per stream. There is no workaround for this vulnerability."
      },
      "products": [
        {
          "@id": "nginx:1.25-alpine",
          "subcomponents": [
            {
              "@id": "pkg:apk/alpine/nghttp2-libs@1.58.0-r0?arch=x86_64&distro=alpine-3.19.1&package-id=6d183ddbc998de11&upstream=nghttp2",
              "name": "nghttp2-libs",
              "version": "1.58.0-r0",
              "purl": "pkg:apk/alpine/nghttp2-libs@1.58.0-r0?arch=x86_64&distro=alpine-3.19.1&upstream=nghttp2"
            }
          ]
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "Severity: MEDIUM - nghttp2 is an implementation of the Hypertext Transfer Protocol version 2 in C. The nghttp2 library prior to version 1.61.0 keeps reading the unbounded number of HTTP/2 CONTINUATION frames even after a stream is reset to keep HPACK context in sync.  This causes excessive CPU usage to decode HPACK stream. nghttp2 v1.61.0 mitigates this vulnerability by limiting the number of CONTINUATION frames it accepts per stream. There is no workaround for this vulnerability.",
      "action_statement": "Component found in SBOM: nghttp2-libs"
